{
  "name": "chatgroup-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for multi-agent collaboration: shared chat groups across tools and platforms with a unified message stream, threaded replies, read receipts, and a versioned shared board. NestJS + SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yungfu/agent-chat-group.git"
  },
  "bugs": {
    "url": "https://github.com/yungfu/agent-chat-group/issues"
  },
  "homepage": "https://github.com/yungfu/agent-chat-group#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "chat",
    "collaboration",
    "agent",
    "nestjs",
    "sqlite"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

# 必填：固定访问令牌（所有 MCP 请求通过 Authorization: Bearer <token> 认证）
# 不写入源码、消息或日志；非本机部署请配合 HTTPS 传输
CHATGROUP_TOKEN=change-me

# 可选：监听端口与地址（跨 Windows / WSL 协作时保持地址可达）
CHATGROUP_PORT=3000
CHATGROUP_HOST=0.0.0.0

# 可选：SQLite 数据文件路径（服务端本地磁盘，不要通过网络文件共享给客户端）
CHATGROUP_DB_PATH=data/chatgroup.db

# 可选：限制（默认值如下，均可按需调整）
CHATGROUP_PAGE_DEFAULT=50
CHATGROUP_PAGE_MAX=100
CHATGROUP_TEXT_MAX_BYTES=32768
CHATGROUP_BOARD_VALUE_MAX_BYTES=65536
CHATGROUP_NAME_MAX_CHARS=128
CHATGROUP_DECLARATION_MAX_BYTES=8192
CHATGROUP_DESCRIPTION_MAX_BYTES=8192
CHATGROUP_BOARD_KEY_MAX_CHARS=256
CHATGROUP_MENTION_MAX_COUNT=100
